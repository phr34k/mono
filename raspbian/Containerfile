# Target: Raspberry Pi Compute Module 4 (BCM2711, aarch64/arm64), Debian trixie base.
# Build on an arm64 host, or cross-build with:  podman build --platform=linux/arm64 ...
#
# trixie ships ostree 2025.2 (no composefs support) but bootc requires ostree
# >= 2025.3 (soft-reboot API) *with* composefs. trixie packages neither a new
# enough ostree nor composefs at all, so we build the whole chain from source:
#   libcomposefs -> ostree 2025.7 (--with-composefs) -> bootc
# and ship the built libraries into the runtime image.
FROM scratch AS ctx

COPY ../shared/ /shared

FROM docker.io/library/debian:trixie AS base

FROM base AS builder

# Enable deb-src so `apt build-dep ostree` can pull ostree's full build
# toolchain (autotools, glib, gpgme, curl, libarchive, fuse, selinux, ...).
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources && \
    apt update -y && \
    apt build-dep -y ostree && \
    apt install -y git curl make build-essential go-md2man libzstd-dev pkgconf dracut \
                   meson ninja-build libfuse3-dev libssl-dev ca-certificates

ENV PKG_CONFIG_PATH=/usr/lib/pkgconfig

# --- libcomposefs (not packaged in trixie) ---
WORKDIR /src/composefs
RUN git clone --depth 1 -b v1.0.8 https://github.com/composefs/composefs.git . && \
    meson setup build --prefix=/usr --libdir=lib -Dman=disabled && \
    meson compile -C build && \
    DESTDIR=/output meson install -C build && \
    cp -a /output/usr/. /usr/ && ldconfig

# --- ostree 2025.7 with composefs support ---
WORKDIR /src/ostree
RUN git clone --depth 1 -b v2025.7 --recurse-submodules https://github.com/ostreedev/ostree.git . && \
    NOCONFIGURE=1 ./autogen.sh && \
    ./configure --prefix=/usr --libdir=/usr/lib \
                --with-composefs --with-curl --without-soup \
                --disable-introspection --disable-gtk-doc --disable-man && \
    make -j"$(nproc)" && \
    make install DESTDIR=/output && \
    cp -a /output/usr/. /usr/ && ldconfig

# --- bootc (builds against our ostree 2025.7 via pkg-config) ---
ENV CARGO_HOME=/tmp/rust
ENV RUSTUP_HOME=/tmp/rust
WORKDIR /home/build
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    curl --proto '=https' --tlsv1.2 -sSf "https://sh.rustup.rs" | sh -s -- --profile minimal -y && \
    sh -c ". ${RUSTUP_HOME}/env ; /ctx/shared/build.sh"

FROM base AS system

# libostree-1-1 is installed only to pull ostree's runtime dependency closure
# (glib, curl, gpgme, libarchive, fuse, mount, selinux, ...); the COPY below
# then overlays our source-built ostree 2025.7 + libcomposefs on top of it.
RUN sed -i 's/^Components: .*/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot apt update -y && \
  apt install -y btrfs-progs bubblewrap dosfstools dracut e2fsprogs fdisk firmware-linux-free firmware-brcm80211 \
    fuse3 libssl3 libcurl4t64 libostree-1-1 linux-image-arm64 raspi-firmware netplan.io libnss-resolve libnss-myhostname \
    openssh-server skopeo systemd systemd-resolved xfsprogs && \
  cp /boot/vmlinuz-* "$(find /usr/lib/modules -maxdepth 1 -type d | tail -n 1)/vmlinuz" && \
  apt clean -y

# Overlay source-built bootc + ostree 2025.7 + libcomposefs, then refresh the
# dynamic linker cache so the new libostree/libcomposefs are resolvable.
COPY --from=builder /output /
RUN ldconfig

RUN systemctl enable systemd-networkd systemd-resolved ssh && \
    printf 'L! /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf\n' \
        > /usr/lib/tmpfiles.d/resolv-conf.conf && \
    mkdir -p /etc/netplan && \
    printf 'network:\n  version: 2\n  ethernets:\n    all-en:\n      match:\n        name: en*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n    all-eth:\n      match:\n        name: eth*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n' > /etc/netplan/90-default.yaml && \
    sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config || true

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/shared/initramfs.sh

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    sed -i 's|^HOME=.*|HOME=/var/home|' "/etc/default/useradd" && \
    /ctx/shared/bootc-rootfs.sh

LABEL containers.bootc 1

RUN bootc container lint
