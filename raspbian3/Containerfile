# raspbian3: U-Boot (UEFI) + GRUB(+blscfg), installed/updated by cross-built
# bootupd, for the CM4 -- layered on the cross-built raspian2 image.
#
# Boot chain on the CM4:
#   BCM2711 EEPROM -> (ESP/FAT) config.txt + start4.elf -> u-boot.bin
#   -> U-Boot `bootflow scan` -> ESP/EFI/BOOT/BOOTAA64.EFI (shim)
#   -> shim -> grubaa64.efi -> grub.cfg -> blscfg -> ostree BLS on ext4 /boot
#   -> kernel + initramfs
#
# Install (supakeen/Ondrej Budai model, https://supakeen.com/weblog/bootc-on-the-raspberry-pi/):
# at `bootc install` the shim copies the Pi firmware onto the ESP root, then execs
# the real bootupctl UNCHANGED. bootupd's install is additive (manages EFI/, does
# not wipe the ESP root), so firmware + bootloader coexist. Unlike Fedora's base,
# Debian has no pre-set-up bootupd, so we cross-build it AND run
# generate-update-metadata here to create the payload Fedora's base already ships.
# The Debian shim in the payload satisfies bootupd's vendordir detection.
#
# GRUB (not systemd-boot) because /boot is ext4 (EFI firmware reads only FAT).
# blscfg is a Fedora patch absent from upstream/Debian GRUB, and bootupd is not
# packaged for Debian, so both are cross-built from source into separate images:
#   podman build --platform=linux/arm64 -f raspbian3/grub-cross.Containerfile    -t raspbian3-grub .
#   podman build --platform=linux/arm64 -f raspbian3/bootupd-cross.Containerfile -t raspbian3-bootupd .

# ---- Stage 1: assemble the Pi firmware set (NOT the EFI bootloader) ----
FROM --platform=linux/arm64 docker.io/library/debian:trixie AS fw
RUN sed -i 's/^Components: .*/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends u-boot-rpi && \
    apt-get download raspi-firmware shim-unsigned grub-common && \
    dpkg-deb -x raspi-firmware_*.deb /rf && \
    dpkg-deb -x shim-unsigned_*.deb /shimpkg && \
    dpkg-deb -x grub-common_*.deb /grubcommon && \
    rm -rf /var/lib/apt/lists/*
COPY raspbian3/config.txt /config.txt
RUN mkdir -p /fw/overlays && \
    cp /config.txt                             /fw/config.txt && \
    cp /usr/lib/u-boot/rpi_arm64/u-boot.bin    /fw/u-boot.bin && \
    cp /rf/usr/lib/raspi-firmware/start*.elf   /fw/ && \
    cp /rf/usr/lib/raspi-firmware/fixup*.dat   /fw/ && \
    cp /rf/usr/lib/raspi-firmware/bootcode.bin /fw/ && \
    cp -a /rf/usr/lib/raspi-firmware/overlays/. /fw/overlays/

# ---- Stage 2: layer onto the cross-built CM4 image ----
FROM localhost/raspian2-bootc:latest

# Pi firmware stash -> the shim copies this onto the ESP at install time.
COPY --from=fw /fw /usr/lib/bootc-raspi-firmwares/

# EFI payload in bootupd's expected layout (usr/lib/efi/<name>/<version>/EFI),
# Fedora-style shim + GRUB so bootupd's vendordir detection (which needs a
# shimaa64.efi) succeeds. On the Pi, U-Boot boots EFI/BOOT/BOOTAA64.EFI (shim),
# which chainloads grubaa64.efi from the same dir; GRUB (prefix /EFI/BOOT) then
# reads grub.cfg. Everything lives in EFI/BOOT so no persistent EFI NVRAM is
# needed (the Pi keeps none).
COPY --from=localhost/raspbian3-grub:latest /BOOTAA64.EFI          /usr/lib/efi/grub2/1/EFI/BOOT/grubaa64.efi
COPY --from=fw /shimpkg/usr/lib/shim/shimaa64.efi                  /usr/lib/efi/grub2/1/EFI/BOOT/shimaa64.efi
COPY --from=fw /shimpkg/usr/lib/shim/shimaa64.efi                  /usr/lib/efi/grub2/1/EFI/BOOT/BOOTAA64.EFI
COPY raspbian3/grub.cfg                                            /usr/lib/efi/grub2/1/EFI/BOOT/grub.cfg

# bootupctl shim (active) + the real cross-built bootupctl it execs unchanged
# (supakeen model). /usr/libexec/bootupd is the same binary, used at build time
# for generate-update-metadata.
COPY raspbian3/bootupctl-shim.sh /usr/bin/bootupctl
COPY --from=localhost/raspbian3-bootupd:latest /bootupd-out/usr/libexec/bootupd /usr/libexec/bootupd
COPY --from=localhost/raspbian3-bootupd:latest /bootupd-out/usr/bin/bootupctl   /usr/bin/bootupctl-orig/bootupctl
# bootupd's grub2-static config snippets (the "stitched" 10_blscfg.cfg etc.).
# bootc passes --write-uuid, so bootupd installs these; without them it fails with
# "Installing static GRUB configs: No such file or directory". Fedora ships them
# in its base; we bring them from the cross-built bootupd image.
COPY --from=localhost/raspbian3-bootupd:latest /bootupd-out/usr/lib/bootupd/grub2-static /usr/lib/bootupd/grub2-static
# bootupd calls `grub2-editenv` (Fedora name) to create grubenv; Debian ships it
# as `grub-editenv` in grub-common. Provide the arm64 binary under the name bootupd
# expects. (Our cross-built GRUB's tools are host/amd64, so we take Debian's arm64 one.)
COPY --from=fw /grubcommon/usr/bin/grub-editenv /usr/bin/grub2-editenv

RUN set -eux; \
    # CM4 device tree(s) from the base kernel -> onto the Pi firmware set.
    cp /usr/lib/linux-image-*/broadcom/bcm2711-rpi-cm4*.dtb /usr/lib/bootc-raspi-firmwares/; \
    chmod +x /usr/bin/bootupctl /usr/bin/bootupctl-orig/bootupctl /usr/libexec/bootupd; \
    # Debian defaults CREATE_HOME=no; Fedora=yes. image-builder's users stage
    # relies on that default when the blueprint user has no explicit home, so
    # match Fedora so `useradd` creates /var/home/<user> (+ .ssh) at build.
    echo 'CREATE_HOME yes' >> /etc/login.defs; \
    # Build bootupd's update manifest (/usr/lib/bootupd/updates/EFI.json) from the
    # staged EFI payload -- required for `backend install` and `bootupctl update`.
    mkdir -p /usr/lib/bootupd/updates; \
    /usr/libexec/bootupd generate-update-metadata /

LABEL containers.bootc 1
