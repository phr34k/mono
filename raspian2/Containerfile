# Target: Raspberry Pi Compute Module 4 (aarch64), Debian trixie base.
#
# This ONE Containerfile builds the COMPLETE CM4 image (published as
# raspbian3-bootc): the from-source OS chain (libcomposefs -> ostree 2025.7 ->
# bootc) PLUS the boot stack (Pi VideoCore firmware + U-Boot, Fedora-patched GRUB
# with blscfg, and coreos bootupd). Previously split across raspian2/Containerfile
# + raspbian3/{Containerfile,grub-cross,bootupd-cross}; now merged into stages:
#   builder - cross-compile composefs/ostree/bootc (native host -> aarch64)
#   grub    - cross-build Fedora GRUB (blscfg) -> arm64-efi BOOTAA64.EFI
#   bootupd - cross-build coreos bootupd (bootloader updater)
#   fw      - assemble the Pi firmware set (VideoCore + U-Boot + shim)
#   system  - the arm64 runtime image; overlays all of the above into the result
#
# The heavy C/Rust compiles run NATIVELY via --platform=$BUILDPLATFORM (NOT
# emulated); only the arm64 runtime bits (apt/dracut, firmware assembly) run as
# the target arch.
#
# Build with:
#   podman build --platform=linux/arm64 -f raspian2/Containerfile -t raspbian3-bootc:latest .
#   (or: just build raspian2)
# CACHING NOTE: files the build steps need are brought in with COPY, NOT with
# `RUN --mount=type=bind,from=<stage>`. buildah (podman 4.9) does NOT layer-cache
# a RUN that carries a bind mount -- it re-executes that step every build, which
# cascades and forces composefs/ostree/bootc to recompile (and re-`git clone`)
# every single time. COPY layers are content-addressed and cache cleanly. Each
# COPY sits right before the step that consumes it, so editing one file only
# invalidates that step and the ones after it. `--mount=type=cache` mounts, by
# contrast, do NOT break caching, so those stay for apt/cargo/ccache speed.

# ---- Cross builder: runs natively on the build host, targets aarch64 ----
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie AS builder

# Enable arm64 multiarch + deb-src, then pull the aarch64 cross toolchain, the
# native build tools, and aarch64 dev libraries (ostree's full build-dep set
# for the arm64 host, plus composefs/bootc extras).
# apt cache mounts persist the cross toolchain + arm64 dev .debs across builds
# (the Debian base's docker-clean dpkg hook purges them -> remove it, and don't
# `rm` the lists, or the /var/lib/apt cache is defeated). ccache is pulled in so
# the C compiles below (composefs, ostree) reuse object files on recompiles.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    dpkg --add-architecture arm64 && \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources && \
    apt update -y && \
    apt install -y ccache crossbuild-essential-arm64 git curl ca-certificates make pkgconf \
                   meson ninja-build python3 autoconf automake libtool gtk-doc-tools bison \
                   libglib2.0-dev:arm64 libgpgme-dev:arm64 libcurl4-openssl-dev:arm64 \
                   libarchive-dev:arm64 libmount-dev:arm64 libselinux1-dev:arm64 \
                   liblzma-dev:arm64 zlib1g-dev:arm64 libcap-dev:arm64 libsystemd-dev:arm64 \
                   libfuse3-dev:arm64 libssl-dev:arm64 libzstd-dev:arm64

# Cross pkg-config: resolve aarch64 .pc files, allow cross for Rust system-deps.
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV PKG_CONFIG_SYSROOT_DIR=/
ENV PKG_CONFIG_ALLOW_CROSS=1
# ccache store lives on a cache mount (see the C-compile RUNs below).
ENV CCACHE_DIR=/root/.ccache

# --- libcomposefs (cross) ---
WORKDIR /src/composefs
COPY ../raspian2/aarch64-cross.txt /raspian2/aarch64-cross.txt
RUN --mount=type=cache,target=/root/.ccache \
    git clone --depth 1 -b v1.0.8 https://github.com/composefs/composefs.git . && \
    meson setup build --cross-file /raspian2/aarch64-cross.txt \
          --prefix=/usr --libdir=lib/aarch64-linux-gnu -Dman=disabled && \
    meson compile -C build && \
    DESTDIR=/output meson install -C build && \
    cp -a /output/usr/. /usr/

# --- ostree 2025.7 with composefs (cross) ---
WORKDIR /src/ostree
RUN --mount=type=cache,target=/root/.ccache \
    git clone --depth 1 -b v2025.7 --recurse-submodules https://github.com/ostreedev/ostree.git . && \
    NOCONFIGURE=1 ./autogen.sh && \
    ./configure --host=aarch64-linux-gnu --build="$(dpkg-architecture -qDEB_BUILD_GNU_TYPE)" \
                CC="ccache aarch64-linux-gnu-gcc" \
                --prefix=/usr --libdir=/usr/lib/aarch64-linux-gnu --sysconfdir=/etc \
                --with-composefs --with-curl --without-soup \
                --with-dracut \
                --with-systemdsystemunitdir=/usr/lib/systemd/system \
                --with-systemdsystemgeneratordir=/usr/lib/systemd/system-generators \
                --disable-introspection --disable-gtk-doc --disable-man && \
    make -j"$(nproc)" && \
    make install DESTDIR=/output && \
    cp -a /output/usr/. /usr/

# --- bootc (cross via cargo) ---
ENV CARGO_HOME=/tmp/rust
ENV RUSTUP_HOME=/tmp/rust
ENV CARGO_BUILD_TARGET=aarch64-unknown-linux-gnu
# Target dir lives OUTSIDE the clone dir (/home/build): the cache mount would
# otherwise pre-create /home/build/target and make `git clone .` fail on a
# non-empty dir. install-bootc.sh honors CARGO_TARGET_DIR to find the binaries.
ENV CARGO_TARGET_DIR=/tmp/cargo-target
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++
WORKDIR /home/build
# Rust toolchain in its OWN layer (installs into /tmp/rust, which persists as
# layer content). It never changes, so it stays cached across bootc recompiles
# instead of re-downloading ~200MB+ every time the build layer below reruns.
RUN curl --proto '=https' --tlsv1.2 -sSf "https://sh.rustup.rs" | \
        sh -s -- --profile minimal -y --default-host "$(dpkg-architecture -qDEB_BUILD_GNU_TYPE | sed 's/-linux-/-unknown-linux-/')" && \
    . "${RUSTUP_HOME}/env" && \
    rustup target add aarch64-unknown-linux-gnu

# Build bootc. Cargo caches: registry/git hold fetched crate sources; the target
# dir holds compiled dependency artifacts (the big time saver). install-bootc.sh
# reads $CARGO_TARGET_DIR in this same RUN, so the mount is live. COPY'd here (not
# earlier) so editing install-bootc.sh doesn't invalidate composefs/ostree.
COPY ../raspian2/install-bootc.sh /raspian2/install-bootc.sh
RUN --mount=type=cache,target=/tmp/rust/registry,sharing=locked \
    --mount=type=cache,target=/tmp/rust/git,sharing=locked \
    --mount=type=cache,target=/tmp/cargo-target,sharing=locked \
    git clone --depth 1 https://github.com/bootc-dev/bootc.git . && \
    . "${RUSTUP_HOME}/env" && \
    cargo build --release --bins && \
    bash /raspian2/install-bootc.sh

# ---- grub: cross-build Fedora's patched GRUB (blscfg) for arm64-efi ----
# Fedora's GRUB carries the blscfg module (absent from upstream/Debian GRUB),
# needed to boot the BLS entries ostree writes. Emits a self-contained
# BOOTAA64.EFI at /BOOTAA64.EFI. Own stage so the slow gnulib bootstrap caches
# independently. (type=cache mounts don't break layer caching; bind mounts do.)
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie AS grub
ENV CCACHE_DIR=/root/.ccache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update -qq && apt-get install -y --no-install-recommends \
        ccache crossbuild-essential-arm64 git make bison flex gettext autopoint autoconf \
        automake libtool pkg-config python3 gawk gperf texinfo help2man ca-certificates \
        xz-utils patch rsync
WORKDIR /src
RUN git clone --depth 1 -b fedora-41 https://github.com/rhboot/grub2.git .
# Generate configure (git tree has no pre-built configure); fetches gnulib.
RUN ./bootstrap
# Cross-configure for arm64-efi: host tools native (BUILD_CC), modules aarch64.
RUN ./configure \
        --target=aarch64-linux-gnu --with-platform=efi \
        --prefix=/usr --disable-werror \
        BUILD_CC="ccache gcc" \
        TARGET_CC="ccache aarch64-linux-gnu-gcc" \
        TARGET_CXX=aarch64-linux-gnu-g++ \
        TARGET_OBJCOPY=aarch64-linux-gnu-objcopy \
        TARGET_STRIP=aarch64-linux-gnu-strip \
        TARGET_NM=aarch64-linux-gnu-nm \
        TARGET_RANLIB=aarch64-linux-gnu-ranlib
RUN --mount=type=cache,target=/root/.ccache \
    make -j"$(nproc)" && make install DESTDIR=/gout
# Assemble the arm64-efi image with blscfg + modules to read ext4 /boot and run
# the BLS entries ostree writes.
RUN ls /gout/usr/lib/grub/arm64-efi/blscfg.mod && \
    /gout/usr/bin/grub-mkimage \
        -O arm64-efi \
        -d /gout/usr/lib/grub/arm64-efi \
        -p /EFI/BOOT \
        -o /BOOTAA64.EFI \
        part_gpt part_msdos ext2 fat normal configfile search search_fs_uuid \
        search_fs_file search_label blscfg linux echo test all_video efi_gop \
        font gfxterm terminal loadenv cat regexp gzio halt reboot && \
    ls -l /BOOTAA64.EFI

# ---- bootupd: cross-build coreos bootupd (bootloader updater) for aarch64 ----
# Debian has no bootupd package (Fedora's bootc base ships one). Produces the
# arm64 bootupd/bootupctl + its grub2-static config snippets under /bootupd-out.
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie AS bootupd
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    dpkg --add-architecture arm64 && apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        build-essential crossbuild-essential-arm64 git curl ca-certificates make pkgconf \
        libssl-dev:arm64
ENV CARGO_HOME=/tmp/rust RUSTUP_HOME=/tmp/rust
ENV CARGO_BUILD_TARGET=aarch64-unknown-linux-gnu
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV PKG_CONFIG_SYSROOT_DIR=/
WORKDIR /src
RUN git clone --depth 1 -b v0.2.35 https://github.com/coreos/bootupd.git .
# Cargo caches: registry/git = crate sources, target/ = compiled artifacts. The
# target cache is ALSO mounted on the install RUN below so it can read the binary
# (cache mounts aren't part of the layer, so a plain next RUN wouldn't see it).
RUN --mount=type=cache,target=/tmp/rust/registry,sharing=locked \
    --mount=type=cache,target=/tmp/rust/git,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --profile minimal --default-host x86_64-unknown-linux-gnu && \
    . "${CARGO_HOME}/env" && rustup target add aarch64-unknown-linux-gnu && \
    cargo build --release
# Install manually (Makefile reads target/release, but CARGO_BUILD_TARGET puts
# the binary under target/<triple>/release). Same target cache mounted here.
RUN --mount=type=cache,target=/src/target,sharing=locked \
    T=target/aarch64-unknown-linux-gnu/release && \
    install -D -m0755 "$T/bootupd" /bootupd-out/usr/libexec/bootupd && \
    install -D -m0755 "$T/bootupd" /bootupd-out/usr/bin/bootupctl && \
    install -m644 -D -t /bootupd-out/usr/lib/bootupd/grub2-static src/grub2/*.cfg && \
    install -m644 -D -t /bootupd-out/usr/lib/bootupd/grub2-static/configs.d src/grub2/configs.d/*.cfg && \
    file /bootupd-out/usr/bin/bootupctl 2>/dev/null || readelf -h "$T/bootupd" | grep Machine

# ---- uboot: rebuild U-Boot for the CM4 with no boot menu + a preboot BMP splash ----
# Debian's stock u-boot-rpi has CONFIG_BOOTDELAY=2 and the bootstd auto-menu, so the
# Pi shows a "Hit any key to stop autoboot" countdown + menu before GRUB, and has no
# early splash (the panel is black until vc4/plymouth at ~4s -- which is why plymouth
# "barely showed"). We rebuild rpi_arm64_defconfig with:
#   CONFIG_BOOTDELAY=0 / CONFIG_AUTOBOOT_MENU_SHOW=n -> no countdown, no U-Boot menu
#   preboot BMP splash -> paint splash.bmp off the FAT at ~1s and hold it (stdout on
#     serial only, so no U-Boot text overwrites it) straight through to plymouth on
#     the same image -> seamless, covering the 0->vc4 black gap.
# Builds natively on the host arch (--platform=$BUILDPLATFORM); cross-compiles with
# aarch64-linux-gnu- on x86_64 hosts. Consumed by the fw stage below.
FROM --platform=$BUILDPLATFORM docker.io/library/debian:trixie AS uboot
ARG UBOOT_REF=v2025.07
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        git make gcc bc bison flex libssl-dev libgnutls28-dev device-tree-compiler \
        python3 python3-setuptools python3-dev swig ca-certificates \
        crossbuild-essential-arm64
WORKDIR /src
RUN git clone --depth 1 --branch "${UBOOT_REF}" https://source.denx.de/u-boot/u-boot.git .
RUN set -eux; \
    if [ "$(dpkg --print-architecture)" = "arm64" ]; then CROSS=""; else CROSS="aarch64-linux-gnu-"; fi; \
    # Blank U-Boot's HDMI text: write only to serial so the panel stays on the
    # splash. Asserted so an upstream rpi.env rename fails the build loudly rather
    # than silently leaving text on screen.
    grep -q '^stdout=serial,vidconsole$' board/raspberrypi/rpi/rpi.env; \
    grep -q '^stderr=serial,vidconsole$' board/raspberrypi/rpi/rpi.env; \
    sed -i -e 's/^stdout=serial,vidconsole$/stdout=serial/' \
           -e 's/^stderr=serial,vidconsole$/stderr=serial/' \
           board/raspberrypi/rpi/rpi.env; \
    # Pin boot to eMMC (skip the slow usb/pxe/dhcp scan) and drop usbkbd from stdin.
    grep -q '^boot_targets=mmc usb pxe dhcp$' board/raspberrypi/rpi/rpi.env; \
    grep -q '^stdin=serial,usbkbd$' board/raspberrypi/rpi/rpi.env; \
    sed -i -e 's/^boot_targets=mmc usb pxe dhcp$/boot_targets=mmc/' \
           -e 's/^stdin=serial,usbkbd$/stdin=serial/' \
           board/raspberrypi/rpi/rpi.env; \
    # Early splash: load splash.bmp off the FAT (mmc 0:1, put there by the bootupctl
    # shim) and center it. `&&` so a missing/failed load never blocks boot. 0x04000000
    # is free scratch RAM, overwritten later by the kernel load.
    printf '%s\n' 'preboot=fatload mmc 0:1 0x04000000 splash.bmp && bmp display 0x04000000 m m' \
        >> board/raspberrypi/rpi/rpi.env; \
    make rpi_arm64_defconfig; \
    ./scripts/config --set-val CONFIG_BOOTDELAY 0; \
    ./scripts/config --disable CONFIG_AUTOBOOT_MENU_SHOW; \
    ./scripts/config --disable CONFIG_VIDEO_LOGO; \
    ./scripts/config --enable CONFIG_USE_PREBOOT; \
    ./scripts/config --enable CONFIG_CMD_BMP; \
    ./scripts/config --enable CONFIG_BMP_16BPP; \
    ./scripts/config --enable CONFIG_BMP_24BPP; \
    ./scripts/config --enable CONFIG_BMP_32BPP; \
    ./scripts/config --enable CONFIG_SPLASH_SCREEN; \
    ./scripts/config --enable CONFIG_SPLASH_SCREEN_ALIGN; \
    make CROSS_COMPILE="$CROSS" olddefconfig; \
    make CROSS_COMPILE="$CROSS" -j"$(nproc)"; \
    cp u-boot.bin /rpi-u-boot.bin

# ---- fw: assemble the Pi firmware set (VideoCore + U-Boot + shim) ----
# Runs as the arm64 target: just extracts .debs, no compilation.
FROM --platform=linux/arm64 docker.io/library/debian:trixie AS fw
RUN sed -i 's/^Components: .*/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources && \
    apt-get update -qq && \
    apt-get download raspi-firmware shim-unsigned grub-common && \
    dpkg-deb -x raspi-firmware_*.deb /rf && \
    dpkg-deb -x shim-unsigned_*.deb /shimpkg && \
    dpkg-deb -x grub-common_*.deb /grubcommon && \
    rm -rf /var/lib/apt/lists/*
COPY raspian2/config.txt /config.txt
# Custom U-Boot (no boot menu + preboot BMP splash) from the uboot stage, replacing
# Debian's stock u-boot-rpi (whose countdown/menu we were seeing before GRUB).
COPY --from=uboot /rpi-u-boot.bin /fw/u-boot.bin
RUN mkdir -p /fw/overlays && \
    cp /config.txt                             /fw/config.txt && \
    cp /rf/usr/lib/raspi-firmware/start*.elf   /fw/ && \
    cp /rf/usr/lib/raspi-firmware/fixup*.dat   /fw/ && \
    cp /rf/usr/lib/raspi-firmware/bootcode.bin /fw/ && \
    cp -a /rf/usr/lib/raspi-firmware/overlays/. /fw/overlays/

# ---- Runtime: the aarch64 target image ----
# Pin to the arm64 target explicitly: the builder pulled debian:trixie as the
# native build arch, and without this podman would reuse that wrong-arch image
# here (making apt look at the amd64 index -> no arm64 linux-image-rpi-v8).
FROM --platform=linux/arm64 docker.io/library/debian:trixie AS system

RUN sed -i 's/^Components: .*/Components: main non-free-firmware/' /etc/apt/sources.list.d/debian.sources

# ---------------------------------------------------------------------------
# Raspberry Pi apt repo -- ONLY for the kernel (linux-image-rpi-v8).
#
# Debian's linux-image-arm64 + raspi-firmware ship only 2 DT overlays (hifiberry,
# spidev), so config.txt `dtoverlay=uart3/4/5` are silent no-ops and the CM4's
# PL011 UARTs (ttyAMA3 = CONTROL RS-485, ttyAMA4 = 4G modem, ttyAMA5 = DMX) never
# appear -- the EPS backend then faults in pl_uart_de and never creates its gui
# socket. The RPi-packaged kernel ships the FULL overlay set (368 overlays) +
# matching CM4 DTBs under /usr/lib/modules/<ver>/dtb/ -- the same source pi-gen /
# RPi-OS / Fedora use. Verity-wise this is safe: composefs here runs enabled=yes
# (see shared/bootc-rootfs.sh, no fs-verity requirement) and --composefs-backend
# seals with dm-verity, which the RPi kernel has (CONFIG_DM_VERITY=m); its lack of
# CONFIG_FS_VERITY is therefore irrelevant.
#
# Keyring is pi-gen's re-signed RPi archive key (the old key's SHA1 self-sig is
# rejected by trixie's sqv). Pin the repo to 100 so it supplies ONLY packages that
# Debian doesn't have (the RPi kernel + its RPi-only deps) and never silently
# upgrades the Debian userland the cross-built ostree/bootc/composefs links against.
#
# Kernel is pinned to the EXACT version linux-image-6.12.75+rpt-rpi-v8 (NOT the
# rolling linux-image-rpi-v8 meta): (a) so "latest" can't shift under us between
# builds, and (b) to test whether the RS-485 DE-timing regression is in the newer
# 6.18 kernel -- 6.12 is the series older pi-gen/RPi-OS images (which had working
# comms) ran. To change kernels, edit the one version string in the apt line below;
# the RPi repo also has 6.12.62/47, 6.18.29/33/34, and -rt (PREEMPT_RT) variants.
COPY raspian2/raspberrypi-archive-keyring.pgp /usr/share/keyrings/raspberrypi-archive-keyring.pgp
RUN printf 'Types: deb\nURIs: http://archive.raspberrypi.com/debian/\nSuites: trixie\nComponents: main\nSigned-By: /usr/share/keyrings/raspberrypi-archive-keyring.pgp\n' \
        > /etc/apt/sources.list.d/raspi.sources && \
    printf 'Package: *\nPin: origin archive.raspberrypi.com\nPin-Priority: 100\n' \
        > /etc/apt/preferences.d/raspberrypi

# apt cache mounts persist the downloaded .debs (/var/cache/apt) and package
# lists (/var/lib/apt) across builds instead of baking them into the layer, so
# re-running this (e.g. adding a package) doesn't re-download everything. The
# Debian base's `docker-clean` purges .debs via a dpkg hook, defeating the cache
# -> remove it. No `apt clean` needed: the debs live in the cache mount, not the
# image. (sudo is installed HERE, not in a derived layer: bootc-rootfs.sh later
# does `rm -rf /var`, wiping /var/lib/dpkg, so apt/dpkg can't run downstream.)
RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
  rm -f /etc/apt/apt.conf.d/docker-clean; \
  apt update -y && \
  apt install -y btrfs-progs bubblewrap dosfstools dracut e2fsprogs fdisk firmware-linux-free firmware-brcm80211 \
    fuse3 libssl3 libcurl4t64 libostree-1-1 linux-image-6.12.75+rpt-rpi-v8 raspi-firmware netplan.io libnss-resolve libnss-myhostname \
    openssh-server podman skopeo sudo systemd systemd-resolved xfsprogs && \
  cp /boot/vmlinuz-* "$(find /usr/lib/modules -maxdepth 1 -type d | tail -n 1)/vmlinuz"

# Overlay cross-built bootc + ostree 2025.7 + libcomposefs, refresh linker cache.
COPY --from=builder /output /
RUN ldconfig

RUN systemctl enable systemd-networkd systemd-resolved ssh && \
    printf 'L! /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf\n' \
        > /usr/lib/tmpfiles.d/resolv-conf.conf && \
    mkdir -p /etc/netplan && \
    printf 'network:\n  version: 2\n  ethernets:\n    all-en:\n      match:\n        name: en*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n    all-eth:\n      match:\n        name: eth*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n' > /etc/netplan/90-default.yaml && \
    sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config || true

# Only the two scripts this stage runs (not all of shared/), so editing an
# unrelated shared/*.sh doesn't invalidate these steps. Removed at the end so the
# scripts don't linger in the committed image.
COPY ../shared/initramfs.sh ../shared/bootc-rootfs.sh /shared/
RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    /shared/initramfs.sh

RUN sed -i 's|^HOME=.*|HOME=/var/home|' "/etc/default/useradd" && \
    /shared/bootc-rootfs.sh && \
    rm -rf /shared

LABEL containers.bootc 1

# ---- Overlay the boot stack onto the runtime image (was raspbian3 stage 2) ----
# supakeen/Budai model (https://supakeen.com/weblog/bootc-on-the-raspberry-pi/):
# at `bootc install` the bootupctl shim copies the Pi firmware onto the ESP, then
# execs the real bootupctl UNCHANGED. bootupd's install is additive (manages EFI/,
# doesn't wipe the ESP root), so firmware + bootloader coexist. Boot chain:
#   BCM2711 EEPROM -> (ESP/FAT) config.txt + start4.elf -> u-boot.bin
#   -> U-Boot bootflow scan -> ESP/EFI/BOOT/BOOTAA64.EFI (shim) -> grubaa64.efi
#   -> grub.cfg -> blscfg -> ostree BLS on ext4 /boot -> kernel + initramfs
# GRUB (not systemd-boot) because /boot is ext4 (EFI firmware reads only FAT).

# Pi firmware stash -> the shim copies this onto the ESP at install time.
COPY --from=fw /fw /usr/lib/bootc-raspi-firmwares/

# EFI payload in bootupd's expected layout (usr/lib/efi/<name>/<version>/EFI),
# Fedora-style shim + GRUB so bootupd's vendordir detection (needs shimaa64.efi)
# succeeds. Everything lives under EFI/BOOT so no persistent EFI NVRAM is needed
# (the Pi keeps none).
COPY --from=grub /BOOTAA64.EFI                                     /usr/lib/efi/grub2/1/EFI/BOOT/grubaa64.efi
COPY --from=fw /shimpkg/usr/lib/shim/shimaa64.efi                  /usr/lib/efi/grub2/1/EFI/BOOT/shimaa64.efi
COPY --from=fw /shimpkg/usr/lib/shim/shimaa64.efi                  /usr/lib/efi/grub2/1/EFI/BOOT/BOOTAA64.EFI
COPY raspian2/grub.cfg                                            /usr/lib/efi/grub2/1/EFI/BOOT/grub.cfg

# bootupctl shim (active) + the real cross-built bootupctl it execs unchanged.
# /usr/libexec/bootupd is the same binary, used at build time for
# generate-update-metadata.
COPY raspian2/bootupctl-shim.sh /usr/bin/bootupctl
COPY --from=bootupd /bootupd-out/usr/libexec/bootupd /usr/libexec/bootupd
COPY --from=bootupd /bootupd-out/usr/bin/bootupctl   /usr/bin/bootupctl-orig/bootupctl
# bootupd's grub2-static config snippets (stitched 10_blscfg.cfg etc.); Fedora
# ships these in its base, we bring them from the cross-built bootupd stage.
COPY --from=bootupd /bootupd-out/usr/lib/bootupd/grub2-static /usr/lib/bootupd/grub2-static
# bootupd calls grub2-editenv (Fedora name); Debian ships grub-editenv in
# grub-common. Provide the arm64 binary under the name bootupd expects.
COPY --from=fw /grubcommon/usr/bin/grub-editenv /usr/bin/grub2-editenv

RUN set -eux; \
    # CM4 device tree(s) + the FULL DT overlay set from the RPi kernel package ->
    # onto the Pi firmware set the bootupctl shim syncs to the ESP. The overlays
    # (uart3/4/5.dtbo etc.) are what make config.txt `dtoverlay=uart3` enable
    # ttyAMA3. NB: the RPi packaging path MOVED between kernel series -- 6.18 ships
    # these under /usr/lib/modules/<ver>/dtb/, 6.12 under /usr/lib/linux-image-<ver>/.
    # So locate the broadcom dir wherever it is; overlays/ is always its sibling.
    DTBDIR="$(dirname "$(find /usr/lib -path '*/broadcom/bcm2711-rpi-cm4-io.dtb' | head -1)")"; \
    test -n "$DTBDIR"; \
    OVLDIR="$(dirname "$DTBDIR")/overlays"; test -d "$OVLDIR"; \
    cp "$DTBDIR"/bcm2711-rpi-cm4*.dtb /usr/lib/bootc-raspi-firmwares/; \
    mkdir -p /usr/lib/bootc-raspi-firmwares/overlays; \
    cp -a "$OVLDIR"/. /usr/lib/bootc-raspi-firmwares/overlays/; \
    chmod +x /usr/bin/bootupctl /usr/bin/bootupctl-orig/bootupctl /usr/libexec/bootupd; \
    # Debian defaults CREATE_HOME=no; match Fedora (yes) so image-builder's users
    # stage creates /var/home/<user> (+ .ssh) at build.
    echo 'CREATE_HOME yes' >> /etc/login.defs; \
    # Build bootupd's update manifest (/usr/lib/bootupd/updates/EFI.json) from the
    # staged EFI payload -- required for `backend install` and `bootupctl update`.
    mkdir -p /usr/lib/bootupd/updates; \
    /usr/libexec/bootupd generate-update-metadata /

# `bootc container lint` on the COMPLETE image. It executes the target-arch
# binary; under qemu-user (cross-build on a non-arm64 host) some syscalls return
# ENOSYS (os error 38) -- an emulation limitation, not an image defect. Non-fatal
# here; run it for real on native arm64 (hardware or an arm64 CI runner).
RUN bootc container lint || \
    echo "WARNING: 'bootc container lint' did not run to completion (qemu-user emulation limitation); run it on native arm64"
