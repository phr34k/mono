# Force LF everywhere. These files are COPY'd verbatim into bootc images and
# executed there; CRLF breaks shell shebangs (#!/bin/bash\r -> bad interpreter),
# sudoers parsing, .desktop Exec= lines, and systemd units. core.autocrlf=true on
# Windows checkouts was corrupting them -- these rules override it for this repo.
* text=auto eol=lf

*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.env       text eol=lf
*.desktop   text eol=lf
*.txt       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*-sudoers   text eol=lf
Containerfile text eol=lf
*.Containerfile text eol=lf
Justfile    text eol=lf
initramfs-modules text eol=lf
# Plymouth theme files are plain-text keyfiles/scripts parsed by plymouthd.
# Debian's plymouth script parser fails hard on CR ("Unparsed characters at end
# of file") -> the splash silently never draws, so these MUST stay LF.
*.script    text eol=lf
*.plymouth  text eol=lf
*.nft       text eol=lf
*.rules     text eol=lf

# Binary assets -- never touch line endings
*.png       binary
*.jpg       binary
*.mp4       binary
*.whl       binary
*.zip       binary
*.gz        binary
*.dtb       binary
*.dtbo      binary
*.bin       binary
*.elf       binary
*.dat       binary
*.pgp       binary
sdcard.key  binary
*_ed25519   binary
